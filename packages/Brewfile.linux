# Portable packages explicitly installed on the host, plus tmux (used directly).
# No service is started by this manifest.
brew "antidote"
brew "bash"
brew "comby"
brew "fd"
brew "fzf"
brew "git"
brew "gnupg"
brew "grpcurl"
brew "herdr"
brew "htop"
brew "jq"
brew "jwt-cli"
brew "lazygit"
brew "luarocks"
brew "lsof"
brew "neovim"
brew "nginx", restart_service: false
brew "redis", restart_service: false
brew "ripgrep"
brew "stow"
brew "tmux"
brew "tmuxinator"
brew "tree"
brew "tree-sitter-cli"
brew "wget"
brew "yarn"
brew "zsh"
